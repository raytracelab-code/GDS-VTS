# Provider settings only. Set credentials in the process environment.
# This file is a template, not an automatic credential loader.
# A key activates AISStream automatically; set false only to explicitly disable.
# AISSTREAM_ENABLED=false
AISSTREAM_API_KEY=
GDS_MARITIME_RADIUS_NM=50
GDS_OWN_MMSI=
GDS_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
GDS_OVERPASS_FALLBACK_ENDPOINTS=https://overpass.private.coffee/api/interpreter
GDS_OPENSEAMAP_ENABLED=false
GDS_OPENWATERS_ENABLED=false
GDS_OPENWATERS_STYLE_URL=https://tiles.openwaters.io/seamap/style.json
GDS_GEBCO_ENABLED=true
GDS_GEBCO_WMS_ENDPOINT=https://wms.gebco.net/mapserv?
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=
GDS_CMEMS_WAVE_DATASET=
GDS_CMEMS_CURRENT_DATASET=
GDS_CMEMS_SST_DATASET=
GDS_CMEMS_SEALEVEL_DATASET=
GDS_GFW_ENABLED=false
GDS_GFW_API_TOKEN=
GDS_GFW_LICENSE_ACK=false
GDS_BOEM_ENABLED=false
GDS_BOEM_BASE_URL=https://gis.boem.gov/server/rest/services/BOEM_BSEE/
GDS_EMODNET_ENABLED=false
GDS_EMODNET_WFS_ENDPOINT=https://ows.emodnet-humanactivities.eu/wfs?
GDS_NAVAREA8_ENABLED=true
GDS_NAVAREA8_SOURCE_URL=https://hydrobharat.gov.in/navarea-warnings/
# Local static/reference data. Empty uses the project data/maritime/malaysia directory.
GDS_MALAYSIA_GIS_PATH=
# Display-only deduplication requires matching platform name and position.
GDS_OFFSHORE_SOURCE_PRIORITY=malaysia_gis,overpass
# Offline map packages (folders containing manifest.json; Windows path list uses ;).
GDS_MAP_PACKAGE_PATH=
GDS_MAP_DEFAULT_PACKAGE=
GDS_MAP_TILE_CACHE_SIZE=128
# NAV uses the existing global OpenFreeMap provider by default.
# Set offline explicitly only when intentionally using an installed package.
GDS_MAP_SOURCE=online
# Legacy offline-engine fallback switch (does not override GDS_MAP_SOURCE).
GDS_MAP_ALLOW_ONLINE_FALLBACK=false
